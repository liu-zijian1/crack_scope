# Optional MQTT. Leave the broker blank to use the built-in HTTP polling only.
CRACKSCOPE_MQTT_BROKER=
CRACKSCOPE_MQTT_PORT=1883
CRACKSCOPE_MQTT_USERNAME=
CRACKSCOPE_MQTT_PASSWORD=
CRACKSCOPE_MQTT_TOPIC_ROOT=crackscope

# Camera and model configuration for hardware mode.
CRACKSCOPE_CAMERA_DEVICE=0
CRACKSCOPE_CAMERA_WIDTH=2560
CRACKSCOPE_CAMERA_HEIGHT=960
CRACKSCOPE_CALIB=calibration/stereo_calibration.npz
CRACKSCOPE_MODEL=models/best.onnx
CRACKSCOPE_MODEL_SIZE=640
